FROM golang:1.23 AS discarder-builder

WORKDIR /src
COPY go.mod ./
COPY cmd/discarder ./cmd/discarder
COPY cmd/manifestctl ./cmd/manifestctl
RUN go test ./cmd/discarder ./cmd/manifestctl \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/discarder ./cmd/discarder \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/manifestctl ./cmd/manifestctl

FROM python:3.13-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates coreutils iproute2 snmp util-linux \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY steam_pumper /app/steam_pumper
COPY --from=discarder-builder /out/discarder /usr/local/bin/discarder
COPY --from=discarder-builder /out/manifestctl /usr/local/bin/manifestctl

RUN mkdir -p /data /tmp /run/pumper && chmod 1777 /tmp

ENV CONFIG_PATH=/data/config.json \
    DISCARDER_DNS_SERVERS=223.5.5.5,119.29.29.29 \
    WEB_PORT=80 \
    TARGET_MBPS=4000 \
    ROLLING_DAYS=15 \
    TARGET_RATIO=2.0 \
    ROTATION_MINUTES=30 \
    SNMP_POLL_SECONDS=60 \
    ENGINE_STATUS_SECONDS=5 \
    SCHEDULER_TICK_SECONDS=60 \
    UPLOAD_CEILING_MBPS=50 \
    DOWNLOAD_CEILING_MBPS=1000 \
    DAILY_MODE_ENABLED=true \
    REMOTE_SOURCE_LIST_ENABLED=false \
    RATE_LIMIT_ENABLED=true \
    LAN_INTERFACE=eth0 \
    LAN_PREFIX=24 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHON_COLORS=0 \
    NO_COLOR=1 \
    TERM=dumb \
    GOMAXPROCS=2 \
    TZ=Asia/Shanghai

EXPOSE 80

CMD ["python3", "-m", "steam_pumper.fleet_main"]
