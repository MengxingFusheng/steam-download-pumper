FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TZ=Asia/Shanghai
WORKDIR /app
COPY dashboard/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt \
    && groupadd --gid 10001 dashboard \
    && useradd --uid 10001 --gid 10001 --no-create-home dashboard \
    && mkdir /data && chown dashboard:dashboard /data
COPY --chown=10001:10001 dashboard /app/dashboard
COPY --chown=10001:10001 steam_pumper/dashboard_protocol.py /app/steam_pumper/dashboard_protocol.py
RUN touch /app/steam_pumper/__init__.py
USER 10001:10001
EXPOSE 8080
CMD ["uvicorn", "dashboard.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]
