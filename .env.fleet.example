# PCDN server local deployment.  This file contains no credentials.
LAN_PARENT=ens18
LAN_SUBNET=192.168.2.0/24
LAN_GATEWAY=192.168.2.1
LAN_PREFIX=24
CONTAINER_IP=192.168.2.11
SNMP_HOST=192.168.2.1
SNMP_PORT=161
# Direct IPv4 DNS servers. Each download process sends DNS through its own
# source IP so a disconnected primary account cannot break all other lines.
DISCARDER_DNS_SERVERS=223.5.5.5,119.29.29.29

# Keep false during installation, source-IP verification and the first account
# calibration.  Set true only after iKuai's per-IP and aggregate limits work.
FLEET_AUTOSTART=false

# Resource ceiling for the auxiliary container on the PCDN server.
FLEET_CPUS=8.0
FLEET_MEMORY=2g
FLEET_WEB_BIND=192.168.1.15
FLEET_WEB_PORT=60080
FLEET_WEB_USERNAME=fleet-admin
FLEET_WEB_AUTH_ENABLED=false
FLEET_PIDS_LIMIT=512

# Replace an offline PPPoE line quickly, then keep it out of selection for a
# while. A line with no progress for 90s is cooled down. Slow lines that still
# transfer bytes keep downloading while the engine switches sources.
LINE_STALL_SECONDS=90
LINE_SLOW_WINDOW_SECONDS=180
LINE_FAILURE_COOLDOWN_MINUTES=30
# Physical counter validation; independent of the 200/500 Mbps scheduling profile.
DOWNLOAD_CEILING_MBPS=1000
# Optional downstream profile for weight=1 accounts; upload remains 50 Mbps.
# This is a scheduling profile, not an enforced network rate limit.
FLEET_STANDARD_DOWNLOAD_MBPS=200

# Fleet always uses daily prediction/group scheduling. Import a CSV with
# confirmed weight=1/10 for every enabled account before starting downloads.
DAILY_MODE_ENABLED=true
ROUTER_SNMP_INTERFACE=wan1
ROUTER_LIMIT_MBPS=5000
ROUTER_RESERVE_MBPS=200
LATE_DOWNLOAD_LIMIT_MBPS=2000
WAN_STALE_SECONDS=120

# Put this on a low-contention local filesystem.  It holds only config and the
# small SQLite rolling ledger; downloaded bodies are discarded in memory.
FLEET_DATA_DIR=./fleet-data

# Optional signed list of verified public Speedtest and mirror download sources.
REMOTE_SOURCE_LIST_ENABLED=false
SOURCE_LIST_URL=
SOURCE_LIST_PUBLIC_KEY=
SOURCE_LIST_KEY_ID=
# Accept a small verified pool; source redundancy is reported separately.
SOURCE_LIST_MIN_SOURCES=1

# Optional outbound cloud dashboard (enable via docker-compose.fleet-dashboard.yml).
# A Fleet image rebuilt from this checkout is required; old latest images lack the agent.
DASHBOARD_URL=
DASHBOARD_NODE_NAME=
DASHBOARD_EXTERNAL_NODE_ID=

# Optional v2 component registration. Leave both empty for existing v1 nodes.
# For an existing shared node, the enrollment secret file must hold a scoped binding token.
DASHBOARD_NODE_ID=
DASHBOARD_COMPONENT_ID=
